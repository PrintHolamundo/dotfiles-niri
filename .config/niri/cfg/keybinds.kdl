recent-windows {
    binds {
        Mod+Tab { next-window; }
        Mod+Shift+Tab { previous-window; }
    }
}

binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

    // ─── DankMaterialShell / Niri Keybinds ───

    Mod+Shift+ESCAPE                     { show-hotkey-overlay; }

    // ─── Applications ───
    Mod+Return                          hotkey-overlay-title="Open Terminal: Kitty" { spawn "kitty"; }
    Mod+B                               hotkey-overlay-title="Open Browser: Brave" { spawn "brave"; }
    Mod+V                               hotkey-overlay-title="Clipboard Manager: CopyQ" { spawn "copyq" "toggle"; }
    Alt+V                               hotkey-overlay-title="Clipboard Manager: CopyQ" { spawn "copyq" "toggle"; }
    Mod+G                               hotkey-overlay-title="Toggle Gemini (Brave App)" { spawn "toggle_gemini.sh"; }
    Mod+T                               hotkey-overlay-title="Toggle Terminal: Kitty (Scratchpad)" { spawn "toggle_kitty.sh"; }
    Mod+N                               hotkey-overlay-title="Open Code Editor: VS Code" { spawn "code"; }
    Mod+Z                               hotkey-overlay-title="Toggle Omnissa Horizon Client (Workspace 2)" { spawn "toggle_omnissa.sh"; }

    // --- DankMaterialShell (DMS) ---
    Mod+Shift+Return                    hotkey-overlay-title="Browse Wallpapers: dms wallpaper" { spawn "dms" "ipc" "call" "dash" "toggle" "wallpaper"; }
    Mod+S                               hotkey-overlay-title="Control Center / Dashboard" { spawn "dms" "ipc" "call" "dash" "toggle"; }
    Mod+Shift+S                         hotkey-overlay-title="Open Settings: dms settings" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Mod+Space                           hotkey-overlay-title="Open App Launcher: dms spotlight" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Alt+Space                           hotkey-overlay-title="Spotlight Bar" { spawn "dms" "ipc" "call" "spotlight-bar" "toggle"; }
    Mod+ALT+L                           hotkey-overlay-title="Lock Screen: dms lock" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+Shift+Q                         hotkey-overlay-title="Power Menu: dms powermenu" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }

    // Please set the text editor of your choice.
    // Mod+Shift+E                               hotkey-overlay-title="Open Text Editor: Zed" { spawn "zed"; }

    // Please choose your own file manager.
    Mod+E                               hotkey-overlay-title="File Manager: Nautilus" { spawn "nautilus"; }

    // ─── Audio Output Switching ───
    Mod+Page_Down                       hotkey-overlay-title="Audio: Blue Microphones" { spawn "audio_blue.sh"; }
    Mod+Page_Up                         hotkey-overlay-title="Audio: Bocinas" { spawn "audio_bocinas.sh"; }
    Mod+Home                            hotkey-overlay-title="Audio: Audífonos Logitech G535" { spawn "audio_audifonos.sh"; }
    Mod+Alt+B                           hotkey-overlay-title="Batería: Consultar estado de periféricos" { spawn "show-batteries.sh"; }

    // ─── Voice Dictation / Autotranscript ───
    Mod+Shift+Page_Down                 hotkey-overlay-title="AutoTranscript (Python Script)" { spawn-sh "kitty -e \"$HOME/AutoTranscript/run.sh\""; }
    Mod+grave                           hotkey-overlay-title="Voice Dictation (Voxtype Toggle)" { spawn "voxtype" "record" "toggle"; }

    // ─── Screen & Audio Recording (GPU Screen Recorder) ───
    Alt+Z                               hotkey-overlay-title="GPU Screen Recorder: Menu Overlay" { spawn "gsr-ui-cli" "toggle-show"; }
    Alt+F9                              hotkey-overlay-title="GPU Screen Recorder: Iniciar/Detener Grabación" { spawn "gsr-ui-cli" "toggle-record"; }
    Alt+F10                             hotkey-overlay-title="Grabar Audio Micrófono Blue" { spawn "toggle_record_blue.sh"; }

    // ─── Media Controls (DMS) ───
    XF86AudioRaiseVolume                allow-when-locked=true cooldown-ms=50 { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioLowerVolume                allow-when-locked=true cooldown-ms=50 { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMute                       allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "micmute"; }
    XF86AudioNext                       allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86AudioPrev                       allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "previous"; }
    Mod+Ctrl+Right                      allow-when-locked=true hotkey-overlay-title="Canción siguiente" { spawn "dms" "ipc" "call" "mpris" "next"; }
    Mod+Ctrl+Left                       allow-when-locked=true hotkey-overlay-title="Canción anterior" { spawn "dms" "ipc" "call" "mpris" "previous"; }
    Mod+Ctrl+Space                      allow-when-locked=true hotkey-overlay-title="Pausar / Reproducir música" { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPlay                       allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPause                      allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }

    // ─── Brightness Controls (DMS) ───
    XF86MonBrightnessUp                 allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }

    // ─── Window Movement and Focus ───
    Mod+Q                               { close-window; }

    Mod+Left                            { focus-column-left; }
    Mod+H                               { focus-column-left; }
    Mod+Right                           { focus-column-right; }
    Mod+L                               { focus-column-right; }
    Mod+Up                              { focus-window-up; }
    Mod+K                               { focus-window-up; }
    Mod+Down                            { focus-window-down; }
    Mod+J                               { focus-window-down; }

    Mod+CTRL+H                          { move-column-left; }
    Mod+CTRL+L                          { move-column-right; }
    Mod+CTRL+UP                         { move-window-up; }
    Mod+CTRL+K                          { move-window-up; }
    Mod+CTRL+Down                       { move-window-down; }
    Mod+CTRL+J                          { move-window-down; }

    // Mod+Home                         { focus-column-first; }
    Mod+End                             { focus-column-last; }
    Mod+CTRL+Home                       { move-column-to-first; }
    Mod+CTRL+End                        { move-column-to-last; }

    Mod+Shift+Left                      { focus-monitor-left; }
    Mod+Shift+Right                     { focus-monitor-right; }
    Mod+Shift+UP                        { focus-monitor-up; }
    Mod+Shift+Down                      { focus-monitor-down; }

    Mod+Shift+CTRL+Left                 { move-column-to-monitor-left; }
    Mod+Shift+CTRL+Right                { move-column-to-monitor-right; }
    Mod+Shift+CTRL+UP                   { move-column-to-monitor-up; }
    Mod+Shift+CTRL+Down                 { move-column-to-monitor-down; }
    Mod+Shift+V                         { switch-focus-between-floating-and-tiling; }

    Mod+BracketLeft                     { consume-or-expel-window-left; }
    Mod+BracketRight                    { consume-or-expel-window-right; }

    Mod+Comma                           { consume-window-into-column; }
    Mod+Period                          { expel-window-from-column; }

    Mod+R                               { switch-preset-column-width; }
    Mod+Shift+R                         { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R                    { switch-preset-window-height; }
    Mod+Ctrl+R                          { reset-window-height; }


    // ─── Workspace Switching ───
    Mod+WheelScrollDown                 cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp                   cooldown-ms=150 { focus-workspace-up; }
    Mod+CTRL+WheelScrollDown            cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+CTRL+WheelScrollUp              cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight                { focus-column-right; }
    Mod+WheelScrollLeft                 { focus-column-left; }
    Mod+CTRL+WheelScrollRight           { move-column-right; }
    Mod+CTRL+WheelScrollLeft            { move-column-left; }

    Mod+Shift+WheelScrollDown           { focus-column-right; }
    Mod+Shift+WheelScrollUp             { focus-column-left; }
    Mod+CTRL+Shift+WheelScrollDown      { move-column-right; }
    Mod+CTRL+Shift+WheelScrollUp        { move-column-left; }

    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }
    Mod+5                               { focus-workspace 5; }
    Mod+6                               { focus-workspace 6; }
    Mod+7                               { focus-workspace 7; }
    Mod+8                               { focus-workspace 8; }
    Mod+9                               { focus-workspace 9; }

    Mod+CTRL+1                          { move-column-to-workspace 1; }
    Mod+CTRL+2                          { move-column-to-workspace 2; }
    Mod+CTRL+3                          { move-column-to-workspace 3; }
    Mod+CTRL+4                          { move-column-to-workspace 4; }
    Mod+CTRL+5                          { move-column-to-workspace 5; }
    Mod+CTRL+6                          { move-column-to-workspace 6; }
    Mod+CTRL+7                          { move-column-to-workspace 7; }
    Mod+CTRL+8                          { move-column-to-workspace 8; }
    Mod+CTRL+9                          { move-column-to-workspace 9; }

    // ─── Layout Controls ───
    Mod+CTRL+F                          { expand-column-to-available-width; }
    Mod+C                               { center-column; }
    Mod+CTRL+C                          { center-visible-columns; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Equal                           { set-column-width "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }


    // ─── Modes ───
    Mod+F                               { maximize-column; }
    Mod+Shift+F                         { fullscreen-window; }
    Mod+W                               { toggle-column-tabbed-display; }

    // ─── Screenshots ───
    F12                                 hotkey-overlay-title="Captura de pantalla: Seleccionar zona" { screenshot; }
    Print                               hotkey-overlay-title="Captura de pantalla: Seleccionar zona" { screenshot; }
    CTRL+Shift+1                        { screenshot; }
    CTRL+Shift+2                        { screenshot-screen; }
    CTRL+Shift+3                        { screenshot-window; }
    Mod+Shift+T                         hotkey-overlay-title="OCR: Capturar y copiar texto" { spawn "ocr-grab"; }

    // ─── System Monitor (Super + Esc) ───
    Mod+ESCAPE                          hotkey-overlay-title="System Monitor: CPU, RAM, GPU (btop)" { spawn "toggle_system_monitor.sh"; }

    // ─── Emergency Escape Key ───
    // Use this when a fullscreen app blocks your keybinds.
    // It disables any active keyboard shortcut inhibitor, restoring control.
    Mod+Ctrl+ESCAPE                     allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ─── Exit / Power ───
    CTRL+ALT+Delete                     { quit; } // Also quits Niri
    Mod+P                               hotkey-overlay-title="Displays: Select Active Monitor" { spawn "monitor_picker.sh"; }
    Mod+Shift+P                         { power-off-monitors; } // Turn off screens (useful for OLED or privacy)
    Mod+O                               repeat=false { toggle-overview; }
}
